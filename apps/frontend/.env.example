# ─── Backend API URL ────────────────────────────────────────────────────────
# Local development
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Production (replace with your Render service URL)
# NEXT_PUBLIC_API_URL="https://kp-whatsapp-automation-backend.onrender.com/api"

# ─── Public site URL ────────────────────────────────────────────────────────
# Canonical origin of the deployed site. Used for SEO: canonical URLs, Open
# Graph tags, the sitemap (/sitemap.xml) and robots (/robots.txt). Set this to
# your real production domain — otherwise it falls back to
# https://kp-whatsapp.vercel.app and search engines index the wrong host.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production:
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
