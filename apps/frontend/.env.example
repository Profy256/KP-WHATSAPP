# ─── Backend API URL ────────────────────────────────────────────────────────
# Local development
NEXT_PUBLIC_API_URL= https://kp-whatsapp-2.onrender.com

# Production (replace with your Render service URL)
# NEXT_PUBLIC_API_URL="https://kp-whatsapp-automation-backend.onrender.com/api"

# ─── Public site URL ────────────────────────────────────────────────────────
# Canonical origin of the deployed site. Used for SEO: canonical URLs, Open
# Graph tags, the sitemap (/sitemap.xml) and robots (/robots.txt). Set this to
# your real production domain — otherwise it falls back to
# https://kp-whatsapp.vercel.app and search engines index the wrong host.
NEXT_PUBLIC_SITE_URL=kp-whatsapp-frontend.vercel.app

# Production:
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Web client ID from Google Cloud Console (used by @react-oauth/google).
# Must match the backend's GOOGLE_CLIENT_ID and be in Authorized JS origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1009718164030-o9c1pnfh4sqn6t5s597neucgiaofcaqv.apps.googleusercontent.com
