# ─── Database (Neon) ────────────────────────────────────────────────────────
# Pooled connection string (with ?pgbouncer=true) — used by Prisma at runtime
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct connection string (no pgBouncer) — used by Prisma migrations
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET="replace-with-a-long-random-secret"

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ───────────────────────────────────────────────────────────────────
# URL of the frontend (Vercel in production, localhost in development)
FRONTEND_URL="http://localhost:3000"

# ─── Resend (email) ─────────────────────────────────────────────────────────
# Get your key at https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Must be a verified domain sender (or use onboarding@resend.dev for testing)
RESEND_FROM="KP WhatsApp Automation <noreply@yourdomain.com>"

# ─── Google OAuth (optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
